<?php
$basePath = isset($basePath) ? rtrim($basePath, '/\\') : null;
$frameCount = isset($frames) ? count($frames) : 0;
$relativePath = function (?string $path) use ($basePath): string {
    if (!is_string($path) || $path === '') {
        return 'n/a';
    }

    if ($basePath && str_starts_with($path, $basePath)) {
        $relative = substr($path, strlen($basePath));
        $relative = ltrim(str_replace('\\', '/', $relative), '/');
        if ($relative !== '') {
            return $relative;
        }
    }

    return str_replace('\\', '/', $path);
};
$escape = fn($value) => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$keywords = [
    'function', 'return', 'throw', 'new', 'public', 'protected', 'private', 'const',
    'class', 'extends', 'implements', 'namespace', 'use', 'if', 'else', 'elseif',
    'try', 'catch', 'finally', 'switch', 'case', 'default', 'foreach', 'as',
    'while', 'do', 'for', 'break', 'continue', 'static', 'var', 'yield', 'final',
    'interface', 'trait', 'abstract', 'global', 'isset', 'unset', 'empty'
];
$keywordPattern = '(?:' . implode('|', array_map('preg_quote', $keywords)) . ')';
$stringPattern = '"(?:\\\\.|[^"\\\\\n])*"|\'(?:\\\\.|[^\'\\\\\n])*\'';
$commentPattern = '\/\/[^\n]*';
$constantPattern = '(?:true|false|null)';
$numberPattern = '\\b\\d+(?:\\.\\d+)?\\b';
$variablePattern = '\\$[A-Za-z_][A-Za-z0-9_]*';
$operatorPattern = '=>|->|===|==|!==|!=|<=|>=|\+\+|--|&&|\|\||\+|-|\*|\/|%';
$pattern = '/(?P<string>' . $stringPattern . ')|(?P<comment>' . $commentPattern . ')|(?P<keyword>\\b' . $keywordPattern . '\\b)|(?P<constant>\\b' . $constantPattern . '\\b)|(?P<number>' . $numberPattern . ')|(?P<variable>' . $variablePattern . ')|(?P<operator>' . $operatorPattern . ')/i';
$highlightLine = function (string $value) use ($escape, $pattern): string {
    $result = '';
    $offset = 0;

    while (preg_match($pattern, $value, $matches, PREG_OFFSET_CAPTURE, $offset)) {
        $match = $matches[0];
        $matchValue = $match[0];
        $matchPos = $match[1];
        $result .= $escape(substr($value, $offset, $matchPos - $offset));

        foreach (['string', 'comment', 'keyword', 'constant', 'number', 'variable', 'operator'] as $token) {
            if (isset($matches[$token][0]) && $matches[$token][0] !== '') {
                $result .= sprintf(
                    '<span class="token-%s">%s</span>',
                    $token,
                    $escape($matches[$token][0])
                );
                break;
            }
        }

        $offset = $matchPos + strlen($matchValue);
    }

    $result .= $escape(substr($value, $offset));
    return $result;
};
$renderLine = fn(string $value) => $value === '' ? '&nbsp;' : $highlightLine($value);
$heroMessage = trim((string)($message ?? ''));
$heroTitle = $heroMessage !== '' ? $heroMessage : 'Something went wrong';
?>

